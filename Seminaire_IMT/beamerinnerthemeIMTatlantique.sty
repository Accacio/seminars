\newcommand{\titlepageimtatlantique}{
		\setbeamertemplate{background}{%
			%\tikz\node[opacity=0.3] at (current page.center) %{\includegraphics[height=\paperheight]{unspecified}};
			\begin{tikzpicture}[remember picture,overlay]

			  \def\angle{50}
			  \def\largeurvert{.25\paperheight}
			  \def\hauteurbleu{.3\paperheight}
			  \def\largeurbleu{.6\paperwidth}
			  \coordinate (bluefonce_bas_droit) at (\largeurbleu,-10 |- current page.south);
			  \coordinate (bluefonce_bas_gauche) at (current page.south west);
			  % \coordinate (bluefonce_haut_droit) at (current page.south west);
			  \coordinate (bluefonce_haut_gauche) at ($ (current page.south west) + (0,\hauteurbleu)$);
			  \coordinate (blueclair_bas_gauche) at (bluefonce_bas_droit);


			  \path[blue,name path=blue120] (bluefonce_bas_droit |- current page.south) -- +({180-\angle}:15);
			  \path[green,name path=blue30] (bluefonce_haut_gauche -| current page.west) -- +({180-\angle-90}:15);
			  \node[name intersections={of=blue120 and blue30, by=bluefonce_haut_droit}] {};
			 \coordinate (vert) at ($(bluefonce_haut_droit) +(-{\angle}:\largeurvert)$);
			  \path[name path=vert90] (vert) -- +({180-\angle-90}:15);
			  \path[name path=top_horz] (current page.north west) -- (current page.north east);

			  \node[name intersections={of=top_horz and blue30, by=vert_haut_gauche}] {};
			  \node[name intersections={of=top_horz and vert90, by=vert_haut_droit}] {};

			\fill[bleufonceimtatlantique] (bluefonce_bas_gauche) -- (bluefonce_bas_droit |- current page.south)  -- (bluefonce_haut_droit) -- (bluefonce_haut_gauche) -- cycle;
			\fill[vertimtatlantique] (bluefonce_haut_droit) -- (vert) -- (vert_haut_droit) -- (vert_haut_gauche) -- cycle;
			\fill[bleuclairimtatlantique] (vert)  -- (bluefonce_bas_droit) -- (current page.south east) -- (current page.north east) -- (vert_haut_droit) -- cycle;

			\pgfdeclareimage[interpolate=true, width=100pt]{imtatlantiquelogo}{inner/imtatlantiquelogo};
			\node[xshift=.3cm,yshift=-.3cm,anchor=north west] at (current page.north west) {\pgfuseimage{imtatlantiquelogo}};
			
			\node[anchor=east,shift={(-.05\paperwidth ,-.5cm)}]  at (current page.east) {
				\begin{tabular}{l}
					\ifx\inserttitle\empty\else
					\usebeamerfont{title}{\color{blancimtatlantique}\inserttitle} \fi\\
					\ifx\insertsubtitle\empty\else
					\usebeamerfont{subtitle}{\usebeamercolor[blancimtatlantique]{subtitle}\insertsubtitle} \fi\\
					\ifx\insertauthor\empty\else
					\usebeamerfont{author}{\usebeamercolor[blancimtatlantique]{author}\insertauthor} \fi\\		
					\ifx\insertinstitute\empty\else		
					\usebeamerfont{institute}{\usebeamercolor[blancimtatlantique]{institute}\insertinstitute} \fi\\
					\ifx\insertdate\empty\else				
					\usebeamerfont{date}{\usebeamercolor[blancimtatlantique]{date}\insertdate}\fi
				\end{tabular}
			};

			\end{tikzpicture}
		}
		\frame[plain]{
%			\thispagestyle{empty}
%			\begin{minipage}[c]{0.36\linewidth}%[hauteur][position]{largeur}
%			\end{minipage}
%			\hfill
%			\begin{minipage}[c]{0.64\linewidth}%[hauteur][position]{largeur}
%			\vspace{2.8cm}
%	\ifx\inserttitle\empty\else
%	\usebeamerfont{title}{\color{blancimtatlantique}\inserttitle} \fi\\
%	\ifx\insertsubtitle\empty\else
%	\usebeamerfont{subtitle}{\usebeamercolor[blancimtatlantique]{subtitle}\insertsubtitle} \fi\\
%	\ifx\insertauthor\empty\else
%	\usebeamerfont{author}{\usebeamercolor[blancimtatlantique]{author}\insertauthor} \fi\\		
%	\ifx\insertinstitute\empty\else		
%	\usebeamerfont{institute}{\usebeamercolor[blancimtatlantique]{institute}\insertinstitute} \fi\\
%	\ifx\insertdate\empty\else				
%	\usebeamerfont{date}{\usebeamercolor[blancimtatlantique]{date}\insertdate}\fi
%			\end{minipage}
		}
		\setbeamertemplate{background}{}
	}

